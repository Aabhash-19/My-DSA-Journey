   "source": [
    "class Solution:\n",
    "    def removeDuplicates(self, nums: List[int]) -> int:\n",
    "        k=0\n",
    "        for num in nums:\n",
    "            if k<2 or num!=nums[k-2]:\n",
    "                nums[k]=num\n",
    "                k=k+1\n",
    "        return k"
   ]
  }
